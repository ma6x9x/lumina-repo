			<key>key</key><string>activeSkin</string>
			<key>label</key><string>Active Skin</string>
			<key>detail</key><string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>Stock (no skin)</string>
				<string>iOS 1-6 (Skeuomorphic)</string>
				<string>iOS 7 (Flat)</string>
				<string>iOS 26 (Liquid Glass)</string>
			</array>
			<key>validValues</key>
			<array>
				<string>stock</string>
				<string>ios1</string>
				<string>ios7</string>
				<string>glass27</string>
