	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Sk1n</string>
			<key>footerText</key><string>Pick an era, then tap Apply &amp; Respring. Changes take effect after the respring. If SpringBoard ever misbehaves, SSH in and run: touch /var/jb/var/mobile/Library/Sk1n/DISABLE</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
